{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','role','wardId','lastSeen'])"
      }
    },

    "requests": {
      "$wardId": {
        ".read": "auth != null",
        "$requestId": {
          ".write": "auth != null && (!data.exists() && newData.child('from').child('uid').val() === auth.uid || data.exists() && (data.child('to').child('uid').val() === auth.uid || data.child('from').child('uid').val() === auth.uid))",
          ".validate": "newData.hasChildren(['from','to','kind','createdAt','status'])",
          "status": {
            ".validate": "newData.val() === 'pending' || newData.val() === 'accepted' || newData.val() === 'declined' || newData.val() === 'done'"
          }
        }
      }
    }
  }
}
